  (text "USB-B\nsocket" (at 198.12 156.21 0) (effects (font (size 1.0 1.0)) (justify left top)) (uuid "989a0163-6e89-41d9-a8ff-811276fdefc1"))
  (text "DC\njack" (at 200.66 175.26 0) (effects (font (size 1.0 1.0)) (justify left top)) (uuid "949e85f0-7ad0-4c00-95cd-d0f0392fa586"))
  (text "top view, pins where they are on the real board" (at 236.22 170.18 0) (effects (font (size 1.0 1.0)) (justify top)) (uuid "7727c8d5-0f3d-4758-99ab-ae95c94e5014"))
  (text "POWER" (at 232.41 172.72 0) (effects (font (size 1.0 1.0)) (justify top)) (uuid "ff031b73-3bed-4750-94ed-7b3ba1f2b4ae"))
  (text "ANALOG IN" (at 252.73 172.72 0) (effects (font (size 1.0 1.0)) (justify top)) (uuid "c2fb1ce9-5ca6-44b0-91cd-b0e7823cf640"))
  (text "DIGITAL" (at 236.22 159.39 0) (effects (font (size 1.0 1.0)) (justify top)) (uuid "8c26651f-bfac-431f-a369-0364ae1602f5"))
  (text "U1  ADS1115 = ADC (analog-to-digital converter)" (at 25.4 93.98 0) (effects (font (size 1.27 1.27) (bold yes)) (justify left top)) (uuid "e77dc6f6-2d94-47fa-88f7-783e463f14c7"))
  (text "Measures the detector voltage on A0 and turns it into a 16-bit number.\nClass kit board, original 1x10 version.\nADDR to GND: I2C address 0x48.\nALRT/RDY to UNO D2: says 'a new reading is ready'.\nHas its own 10 kΩ I2C pull-ups." (at 25.4 97.79 0) (effects (font (size 1.0 1.0)) (justify left top)) (uuid "6b0b5f20-dd0c-47b5-a5d9-c64a6ee33990"))
  (text "U2  MCP4725 = DAC (digital-to-analog converter)" (at 25.4 139.7 0) (effects (font (size 1.27 1.27) (bold yes)) (justify left top)) (uuid "ab6309f0-52fd-40b5-9b92-e274356adf7a"))
  (text "Turns a number from the UNO into a voltage, 0-5 V.\nThat voltage is the mass command for the quadrupole (Team 4).\nSparkFun BOB-12918, A0 jumper to GND: address 0x60.\nOutput sits at mid-scale at power-up." (at 25.4 143.51 0) (effects (font (size 1.0 1.0)) (justify left top)) (uuid "a0d08952-2e64-4683-9499-ccdc415a1e3b"))
  (text "HOW TO READ THIS DRAWING" (at 25.4 163.83 0) (effects (font (size 1.27 1.27) (bold yes)) (justify left top)) (uuid "689e22e2-5dc2-417c-8bf4-bc887abf01af"))
  (text "Green line = wire.  Dot = wires joined.\nWires crossing WITHOUT a dot are NOT connected.\nX on a UNO pin = pin not used by this shield.\nFour vertical rails: +5V (power), SDA (I2C data),\nSCL (I2C clock), GND (0 V return).\nI2C = the 2-wire bus the UNO uses to talk to U1 and U2." (at 25.4 167.64 0) (effects (font (size 1.0 1.0)) (justify left top)) (uuid "c3e2b2bc-ca05-46bc-a2cd-a36f2aa1e4ec"))
  (text "+5V" (at 127.64 104.14 0) (effects (font (size 1.27 1.27) (bold yes)) (justify left top)) (uuid "77f0bec4-0edd-4f6e-98c1-da987fcfd1d6"))
  (text "SDA" (at 135.26 104.14 0) (effects (font (size 1.27 1.27) (bold yes)) (justify left top)) (uuid "ed562e45-205a-49cd-9ef1-69866a5919c2"))
  (text "SCL" (at 142.88 104.14 0) (effects (font (size 1.27 1.27) (bold yes)) (justify left top)) (uuid "fd992f06-7e5a-455c-bec8-08efa3a9f0eb"))
  (text "GND" (at 150.5 104.14 0) (effects (font (size 1.27 1.27) (bold yes)) (justify left top)) (uuid "3cf6a7df-9f58-4481-bfd9-aa96f8612209"))
  (text "ARD1  Arduino UNO R3 = the controller" (at 271.78 99.06 0) (effects (font (size 1.27 1.27) (bold yes)) (justify left top)) (uuid "74585afa-9f0c-4f80-b2c7-8547d26e59ca"))
  (text "Reads U1 and sets U2 over I2C,\nsends the data to the laptop over USB.\nThis board plugs on top of it.\nPin NAMES shown (D2, D8, SDA...), as printed on the UNO.\nSDA/A4 and SCL/A5 are the SAME signals as SDA and SCL:\nthe shield connects both (for clones without SDA/SCL pins).\nNever use A4/A5 as analog inputs.\nYour board: Uno R3 CH340G clone, IOREF is labelled 5V." (at 271.78 102.87 0) (effects (font (size 1.0 1.0)) (justify left top)) (uuid "02e984c0-18f8-4b3c-a618-d7bc63bf0ebc"))
  (text "SIGNAL IN: preamp output from the detector (Team 3)" (at 190.5 35.56 0) (effects (font (size 1.27 1.27) (bold yes)) (justify left top)) (uuid "8cba7031-d17a-4809-82eb-d3334db999c1"))
  (text "RDY: ADC tells the UNO a reading is ready" (at 180.34 26.67 0) (effects (font (size 1.0 1.0)) (justify left top)) (uuid "840430f0-3fc7-4bbc-b7ed-effb1e2456c9"))
  (text "UNITS USED ON THIS DRAWING" (at 274.32 40.64 0) (effects (font (size 1.27 1.27) (bold yes)) (justify left top)) (uuid "24d0e79b-179d-4304-b6fc-c74deacee14f"))
  (text "Ω   ohm: resistance, how hard a part resists current\nkΩ  kilo-ohm = 1000 Ω   (4.7 kΩ = 4700 Ω)\nF   farad: capacitance, how much charge a\n     capacitor stores\nnF  nanofarad = 0.000 000 001 F   (100 nF = 0.1 µF)\nV   volt: voltage, the electrical 'pressure'\nA   ampere: current, the flow of charge\nmA  milliampere = 0.001 A\nW   watt: power; the resistors are rated 0.25 W\nHz  hertz: frequency, cycles per second\nbit binary digit; 16-bit = 65 536 steps\n0x48, 0x60: I2C addresses, written in hexadecimal\n+/-  plus or minus (+/-12 V = from -12 V to +12 V)" (at 274.32 44.45 0) (effects (font (size 1.0 1.0)) (justify left top)) (uuid "50d5c9bc-0114-4e52-a38c-598bc90f88e7"))
  (wire (pts (xy 100.33 77.47) (xy 111.76 77.47)) (stroke (width 0) (type default)) (uuid "9c44ec76-c8e0-4656-8a7e-8f4a8bb8034d"))
