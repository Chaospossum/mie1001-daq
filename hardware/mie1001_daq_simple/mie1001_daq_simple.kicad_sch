    (property "Datasheet" "" (at 180.34 67.31 0) (effects (font (size 1.27 1.27)) (hide yes)))
    (property "Description" "Ceramic disc capacitor, through-hole" (at 180.34 67.31 0) (effects (font (size 1.27 1.27)) (hide yes)))
    (property "Rating" "100 nF 50 V X7R ceramic" (at 180.34 67.31 0) (effects (font (size 1.27 1.27)) (hide yes)))
